# MyCEO Authenticator used by the app's login.
# dev: https://authenticator-dev.mydailyceo.com · prod: https://authenticator.mydailyceo.com
EXPO_PUBLIC_MYCEO_AUTH_URL=https://authenticator-dev.mydailyceo.com
# Public client id of the "AATOS Android" ClientApp (not a secret).
EXPO_PUBLIC_MYCEO_CLIENT_ID=myceo_app_aatos_android

# Auria backend (aatos-system, routes under /auria/). Production by default (spec 002, D-05).
# prod: https://pilarone.mydailyceo.com · dev: https://pilarone-dev.mydailyceo.com
EXPO_PUBLIC_AURIA_API_URL=https://pilarone.mydailyceo.com
# Billing service, read to block sending when the credits ran out.
# prod: https://settings.mydailyceo.com · dev: https://settings-dev.mydailyceo.com
EXPO_PUBLIC_SETTINGS_URL=https://settings.mydailyceo.com
